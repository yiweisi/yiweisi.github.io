{% capture footer_contents %}
  &copy; Copyright {{ site.time | date: '%Y' }}
  {{ site.first_name }}
  {{ site.middle_name }}
  {{ site.last_name }}. {{ site.footer_text }}
  {% if site.impressum_path %}
    <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
  {% endif %}
  {% if site.last_updated %}
    Last updated: {{ 'now' | date: '%B %d, %Y' }}.
  {% endif %}
{% endcapture %}

{% capture footer_social %}
  <div class="d-flex align-items-center" style="gap: 20px;">
    <a href="mailto:yiwei.si@bfsu.edu.cn"
       aria-label="Email"
       title="Email">
      <i class="fa-solid fa-envelope fa-lg"></i>
    </a>

    <a href="https://scholar.google.com/citations?user=9yb0snwAAAAJ"
       target="_blank"
       rel="noopener noreferrer"
       aria-label="Google Scholar"
       title="Google Scholar">
      <i class="ai ai-google-scholar ai-lg"></i>
    </a>
  </div>
{% endcapture %}

{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0">
      <div class="d-flex justify-content-between align-items-center flex-wrap" style="gap: 12px;">
        <div>{{ footer_contents }}</div>
        {{ footer_social }}
      </div>
    </div>
  </footer>
{% else %}
  <footer class="sticky-bottom mt-5" role="contentinfo">
    {% if site.newsletter.enabled %}
      {% include newsletter.liquid %}
    {% endif %}

    <div class="container">
      <div class="d-flex justify-content-between align-items-center flex-wrap" style="gap: 12px;">
        <div>{{ footer_contents }}</div>
        {{ footer_social }}
      </div>
    </div>
  </footer>
{% endif %}
